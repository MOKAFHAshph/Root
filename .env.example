# الإعدادات الأساسية
TELEGRAM_BOT_TOKEN=
ADMIN_ID=
CHANNEL_USERS=
CHANNEL_ADMIN=
CHANNEL_BACKUP=
APP_NAME=بوت بيع USDT
ADMIN_CONTACT=@your_username
DB_FILE=crypto_sales_bot.db
LOG_FILE=crypto_sales_bot.log

# التطبيق المصغر
MINI_APP_URL=https://example.com/app
MINI_APP_PORT=8081

# Jaib — لا تضع القيم الحقيقية في أي ملف عام
JAIB_PHONE=
JAIB_PASSWORD=
JAIB_FCM_KEY_B64=
JAIB_FCM_IV_B64=
JAIB_CLIENT_IV_B64=
JAIB_DEVICE_ID=
JAIB_SMS_CODE=
JAIB_TKN_NOT=
JAIB_INIT_VALUE=
JAIB_AUTH_HEADER=
JAIB_OP_QUERY_REF=567
JAIB_INIT_TIMEOUT_SECONDS=10
JAIB_REQUEST_TIMEOUT_SECONDS=15
# Recommended true. Set false only to reproduce the legacy Jaib client TLS behavior.
JAIB_TLS_VERIFY=true
# Optional fallback hosts are automatically supplemented from the working reference list.
JAIB_HEALTH_CHECK_INTERVAL_SECONDS=60
JAIB_VERIFY_RETRY_ATTEMPTS=3
JAIB_VERIFY_RETRY_DELAY_SECONDS=3
JAIB_API_UTC_OFFSET_HOURS=3

# Binance — المزود المالي الوحيد؛ الشبكات تُدار من لوحة الأدمن
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WITHDRAW_ENABLED=false
AUTO_ONCHAIN_WITHDRAW=true
ALLOWED_NETWORKS=BSC:BEP20
BEP20_ENABLED=true
BINANCE_EGRESS_IP_CHECK_ENABLED=true

# العرض والتشغيل
DEFAULT_USDT_RATE_YER=550
DISPLAY_DECIMALS_DEFAULT=4
PUBLIC_LIQUIDITY_ENABLED_DEFAULT=true
ACCOUNT_VERIFICATION_MIN_YER=100
ACCOUNT_VERIFICATION_MAX_YER=300
ACCOUNT_VERIFICATION_STEP_YER=50

# V19: dedicated mainnet V4R2 wallet. Never put mnemonic words here.
TON_HOT_ADDRESS=
TON_MNEMONIC_FILE=
TONCENTER_API_KEY=
# Verified incoming-statement adapter only; leave empty until integrated.
JAIB_STATEMENT_ADAPTER=
# Optional path to a trusted CA bundle for Jaib TLS validation.
JAIB_CA_BUNDLE=
# V20: preserved by install_update20.py from the existing installed provider.
# Set these only from your verified Jaib client profile; no values shipped in code.
JAIB_CLIENT_KEY=
JAIB_CLIENT_SECRET=
JAIB_RETURN_KEY=
JAIB_APP_VERSION=446
# Manual administrative STON.fi swaps (customer native TON sales remain hidden).
TON_ADMIN_SWAP_ENABLED=false
